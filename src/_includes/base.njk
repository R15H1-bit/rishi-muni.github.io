<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ summary or site.about_short }}">
  <link rel="preload" href="/assets/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/katex/katex.min.css">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#main">Skip to content</a>
  <header class="masthead">
    <a class="masthead__name" href="/">{{ site.name }}</a>
    <nav aria-label="Main">
      <a href="/#work"{% if page.url.startsWith("/projects/") %} aria-current="page"{% endif %}>Work</a>
      <a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a>
      <a href="{{ site.resume }}">Résumé</a>
    </nav>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="colophon">
    <p>{{ site.name }} — <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    <ul>
      {% for l in site.links %}<li><a href="{{ l.url }}">{{ l.label }}</a></li>{% endfor %}
    </ul>
  </footer>

  <dialog class="lightbox" aria-label="Enlarged image">
    <img alt="">
    <button type="button" class="lightbox__close">Close</button>
  </dialog>
  <script src="/assets/js/site.js" defer></script>
</body>
</html>
